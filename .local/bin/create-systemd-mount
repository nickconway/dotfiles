#!/usr/bin/env bash
set -euo pipefail

eval "$(
    get-options \
        "-t, --type: TYPE='\$ARG'" \
        "-o, --options: OPTIONS='\$ARG'" \
        "-s, --timeout, --seconds: OPTIONS='\$ARG'" \
        "-u, --user: USER_MODE=true" \
        -- "$@"
)"

if [[ -z ${ARGS:-} ]] || [[ ${#ARGS[@]} -lt 2 ]]; then
    echo "Usage: $(basename $0) <REMOTE_LOCATION> <LOCAL_LOCATION>"
    exit
fi

WHAT=${ARGS[0]}
WHERE=${ARGS[1]}

ESCAPED=$(systemd-escape $WHERE)

if [[ $ESCAPED == -* ]]; then
    ESCAPED=$(cut -d - -f 2- <<<"$ESCAPED")
fi

if [[ -e /etc/systemd/system/$ESCAPED.mount ]]; then
    echo "Mount file already exists"
    exit
fi

if [[ -z ${USER_MODE:-} ]]; then
    DIR=/etc/systemd/system
else
    DIR="$HOME/.config/systemd/user"
fi

cat <<EOF | tee $DIR/$ESCAPED.mount
[Unit]
Description=Mount $WHAT to $WHERE
After=network-online.target
Wants=network-online.target

[Mount]
What=$WHAT
Where=$WHERE
Options=${OPTIONS:-auto}
Type=${TYPE:-nfs}
TimeoutSec=${TIMEOUT:-60}

[Install]
WantedBy=default.target
EOF

systemctl ${USER_MODE:+--user} enable --now $ESCAPED.mount
