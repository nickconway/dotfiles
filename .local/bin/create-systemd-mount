#!/usr/bin/env bash
set -euo pipefail

eval "$(
    get-options \
        "-t, --type: TYPE='\$ARG'" \
        "-o, --options: OPTIONS='\$ARG'" \
        "-s, --timeout, --seconds: OPTIONS='\$ARG'" \
        -- "$@"
)"

if [[ -z ${ARGS:-} ]] || [[ ${#ARGS[@]} -lt 2 ]]; then
    echo "Usage: $(basename $0) <REMOTE_LOCATION> <LOCAL_LOCATION>"
    exit
fi

WHAT=${ARGS[0]}
WHERE=${ARGS[1]}

ESCAPED=$(systemd-escape $WHERE)

if [[ $ESCAPED == -* ]]; then
    ESCAPED=$(cut -d - -f 2- <<<"$ESCAPED")
fi

DIR=/etc/systemd/system

if [[ -e $DIR/$ESCAPED.mount ]]; then
    echo "Mount file already exists"
    exit
fi

cat <<EOF | tee $DIR/$ESCAPED.mount
[Unit]
Description=Mount $WHAT to $WHERE
After=network-online.target
Wants=network-online.target

[Mount]
What=$WHAT
Where=$WHERE
Options=${OPTIONS:-auto}
Type=${TYPE:-nfs}
TimeoutSec=${TIMEOUT:-60}

[Install]
WantedBy=default.target
EOF

if ! systemctl enable --now $ESCAPED.mount; then
    systemctl disable --now $ESCAPED.mount
    rm $DIR/$ESCAPED.mount
fi
