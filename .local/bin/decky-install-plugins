#!/usr/bin/env bash
set -euo pipefail

if ! systemctl is-active plugin_loader &>/dev/null; then
    exit 1
fi

until nc -z localhost 1337; do
    sleep 5
done

function get-url() {
    NAME=
    URL=
    RELEASES=

    if [[ "$1" == *.zip ]]; then
        NAME="$1"
        URL="$1"
    else
        case "$1" in

        'https://github.com/moraroy/NonSteamLaunchersDecky')
            echo "Got NonSteamLaunchers" 1>&2
            echo 'https://github.com/moraroy/NonSteamLaunchersDecky/archive/refs/heads/main.zip'
            return
            ;;

        *) ;;
        esac

        if [[ "$1" == *github* ]]; then
            NAME="$(sed 's,https://github.com/,,g' <<<"$1")"
            RELEASES="$(
                if command -v gh &>/dev/null; then
                    gh api https://api.github.com/repos/"$NAME"/releases
                else
                    curl -fsSL https://api.github.com/repos/"$NAME"/releases
                fi
            )"
        fi

        if [[ -n "$RELEASES" ]] && [[ "$RELEASES" != null ]]; then
            URL="$(
                jq -r 'first.assets[] | select(.name | endswith("zip"))| .browser_download_url' <<<"$RELEASES" 2>/dev/null | head -n 1 || echo null
            )"
        fi
    fi

    if [[ -n "$URL" ]] && [[ "$URL" != null ]]; then
        echo "$URL"

        NAME="$(basename "$URL")"
        echo "Got $NAME" 1>&2
    else
        NAME="$(basename "$1")"
        echo "Could not install $NAME" 1>&2
    fi
}

eval "$(read-array "$@" -n LINKS <"$HOME/.config/decky/plugins.txt")"

DATA="$(
    echo -n '['
    for f in "${LINKS[@]}"; do
        URL="$(get-url "$f")"

        if [[ -n "$URL" ]]; then
            echo -n "\"$URL\""
        fi
    done | sed 's/""/", "/g'
    echo -n ']'
)"

AUTH="$(curl -fsSL http://localhost:1337/auth/token)"

curl -fsSL -X POST -H "X-Decky-Auth: $AUTH" http://localhost:1337/plugins/install -d "$DATA"
