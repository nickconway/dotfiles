#!/usr/bin/env bash
set -euo pipefail

function clean() {
    if [[ -n ${SPID:-} ]]; then
        kill $SPID
    fi

    rm -f /tmp/.inhibit-{lock,sleep}
}

trap clean EXIT

function steam-download() {
    grep path $HOME/.local/share/Steam/steamapps/libraryfolders.vdf | awk '{print $2}' | tr -d '"' | while read -r p; do
        while inotifywait -t 5 $p/steamapps/downloading; do
            true
        done
    done
}

touch /tmp/.inhibit-{lock,sleep}

if pidof -q hypridle; then
    $*
elif command -v systemd-inhibit &>/dev/null; then
    systemd-inhibit sleep infinity &
    SPID=$!
    $*
else
    $*
fi
