#!/usr/bin/env bash
set -euo pipefail

WIDTH=${SUNSHINE_CLIENT_WIDTH:-3840}
HEIGHT=${SUNSHINE_CLIENT_HEIGHT:-2160}
FPS=${SUNSHINE_CLIENT_FPS:-120}

if [[ $1 == "do" ]]; then
    if pidof hyprlock; then
        kill $(pidof hyprlock)
        touch /tmp/.sunshine-lock
    fi

    loginctl unlock-session

    pkill -STOP -x hypridle &>/dev/null

    hyprctl eval "$(
        for m in $(hyprctl monitors -j | jq -r '.[] | .name' | grep -v Sunshine); do
            echo "hl.monitor({ output = \"$m\", disabled = true })"
        done
    )"

    hyprctl eval "hl.monitor({ output = 'Sunshine', mode = '${WIDTH}x${HEIGHT}@${FPS}', scale = '1', disabled = false })"
    hyprctl eval 'hl.workspace_rule({ workspace = "name:game", monitor = "Sunshine", default = true })'

    hyprctl eval 'hl.dispatch(hl.dsp.focus({ monitor = "Sunshine" }))'
    hyprctl eval 'if hl.get_workspace("name:game") then hl.dispatch(hl.dsp.workspace.move({ workspace = "name:game", monitor = "Sunshine" })) end'
elif [[ $1 == "undo" ]]; then
    pkill -CONT -x hypridle &>/dev/null

    hyprctl eval "hl.monitor({ output = 'Sunshine', disabled = true })"

    hyprctl eval "$(
        for m in $(hyprctl monitors -j | jq -r '.[] | .name' | grep -v Sunshine); do
            echo "hl.monitor({ output = \"$m\", disabled = false })"
        done
    )"

    hyprctl eval 'hl.workspace_rule({ workspace = "name:game", monitor = "1", default = false })'

    if [[ -e /tmp/.sunshine-lock ]]; then
        rm /tmp/.sunshine-lock
        loginctl lock-session
    fi
fi
