#!/usr/bin/env bash
set -euo pipefail

WIDTH=${SUNSHINE_CLIENT_WIDTH:-3840}
HEIGHT=${SUNSHINE_CLIENT_HEIGHT:-2160}
FPS=${SUNSHINE_CLIENT_FPS:-120}

if [[ $1 == "do" ]]; then
    touch /tmp/.inhibit-{lock,sleep}

    if pgrep --quiet start-hyprland; then
        hyprctl monitors -j >/tmp/sunshine-monitors.json

        hyprctl eval "$(
            for m in $(hyprctl monitors -j | jq -r '.[] | .name' | grep -v Sunshine); do
                echo "hl.monitor({ output = \"$m\", disabled = true })"
            done

            echo "hl.monitor({ output = 'Sunshine', mode = '${WIDTH}x${HEIGHT}@${FPS}', scale = '1', disabled = false })"
            echo 'hl.workspace_rule({ workspace = "name:game", monitor = "Sunshine", default = true })'

            echo 'if hl.get_workspace("name:game") then hl.dispatch(hl.dsp.workspace.move({ workspace = "name:game", monitor = "Sunshine" })) end'
        )"
    fi

    yeetmousectl apply ~/.config/yeetmouse/none

    if pidof hyprlock &>/dev/null; then
        kill -USR1 $(pidof hyprlock)
        touch /tmp/.sunshine-lock
        LOCKED=true
    fi

    loginctl unlock-session

    if pgrep --quiet start-hyprland && [[ -n ${LOCKED:-} ]]; then
        hyprctl eval 'hl.clear_crashed_lockscreen()'
    fi
elif [[ $1 == "undo" ]]; then
    if pgrep --quiet start-hyprland; then
        while read -r m; do
            name=$(echo "$m" | jq -r '.name')
            width=$(echo "$m" | jq -r '.width')
            height=$(echo "$m" | jq -r '.height')
            refresh=$(echo "$m" | jq -r '.refreshRate')
            x=$(echo "$m" | jq -r '.x')
            y=$(echo "$m" | jq -r '.y')
            scale=$(echo "$m" | jq -r '.scale')

            hyprctl eval "hl.monitor({
                output = \"$name\",
                disabled = false,
                mode = \"${width}x${height}@${refresh}\",
                position = \"${x}x${y}\",
                scale = $scale
            })"
        done < <(
            if [[ -e /tmp/sunshine-monitors.json ]]; then
                jq -c '.[] | select(.disabled == false)' /tmp/sunshine-monitors.json
            fi
        )

        hyprctl eval "hl.monitor({ output = 'Sunshine', disabled = true })"
    fi

    if [[ -e /tmp/.sunshine-lock ]]; then
        rm /tmp/.sunshine-lock
        loginctl lock-session
    fi

    yeetmousectl apply ~/.config/yeetmouse/$HOSTNAME

    rm -f /tmp/.inhibit-{lock,sleep}
    rm -f /tmp/sunshine-monitors.json
fi
